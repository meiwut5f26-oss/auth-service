# This project uses a single `.env` file at the repository root for configuration.
# Copy this file to `.env` and fill in values for local development.
# DO NOT commit secrets into `.env`.

# Example variables (expand as needed):
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://mysql:3306/authentication_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-db-password

# MySQL container
MYSQL_ROOT_PASSWORD=your-db-password
MYSQL_DATABASE=authentication_db

# Mail
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-mail-app-password

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Bootstrap admin account
ADMIN_INIT_ENABLED=true
ADMIN_INIT_EMAIL=admin@csfc.local
ADMIN_INIT_PASSWORD=ChangeMe@123
ADMIN_INIT_NAME=System Admin
ADMIN_INIT_ROLE=ADMIN

# Eureka (optional)
EUREKA_CLIENT_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

