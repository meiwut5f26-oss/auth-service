# ========================
# SERVER
# ========================
SERVER_PORT=8081

# ========================
# SERVICE URLs
# ========================
ORDER_SERVICE_URL=https://api-gate-way.onrender.com
FRANCHISE_SERVICE_URL=https://api-gate-way.onrender.com

# ========================
# DATABASE (PostgreSQL)
# ========================
DB_URL=jdbc:postgresql://localhost:5444/auth_db
DB_USERNAME=user
DB_PASSWORD=pass

# ========================
# MAIL (Gmail SMTP)
# ========================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
# Use Gmail App Password, NOT your real password

# ========================
# ADMIN INIT
# ========================
ADMIN_INIT_ENABLED=true
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=admin123
ADMIN_INIT_NAME=System Admin
ADMIN_INIT_ROLE=ADMIN

# ========================
# EUREKA (SERVICE DISCOVERY)
# ========================
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka/
RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# ========================
# JWT CONFIG
# ========================
JWT_SECRET=your_super_secret_key_very_long_and_secure
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
