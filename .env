SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/csfc_auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=csfc_user
DB_PASSWORD=csfc_pass

# MySQL container
MYSQL_ROOT_PASSWORD=your-db-password
MYSQL_DATABASE=authentication_db

# Mail
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# JWT
JWT_SECRET=your-long-random-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Admin bootstrap
ADMIN_INIT_ENABLED=true
ADMIN_INIT_EMAIL=admin@csfc.local
ADMIN_INIT_PASSWORD=ChangeMe@123
ADMIN_INIT_NAME=System Admin
ADMIN_INIT_ROLE=ADMIN

# Eureka (set to true and provide URL if using Eureka)
EUREKA_CLIENT_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/