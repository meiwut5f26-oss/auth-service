# ========================
# SERVER
# ========================
SERVER_PORT=8081 // not truely needed since Spring Boot defaults to 8080, but can be overridden if needed

# ========================
# SERVICE URL (API Gateway or direct service)
# ========================
SERVICE_URL=https://api-gate-way.onrender.com

# ========================
# DATABASE (PostgreSQL)
# ========================
// will change to actual connection string in Spring Boot config, but these can be used for local development or as env vars
DB_HOST=localhost
DB_PORT=5444
DB_NAME=auth_db
DB_USER=user
DB_PASS=pass

# (Optional if you want to inline directly instead of splitting above)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5444/auth_db
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=pass

# ========================
# MAIL (Gmail SMTP)
# ========================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ⚠️ Use Gmail App Password, NOT your real password

# ========================
# ADMIN INIT (AUTO CREATE ADMIN USER)
# ========================
ADMIN_INIT_ENABLED=true
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=admin123
ADMIN_INIT_NAME=System Admin
ADMIN_INIT_ROLE=ADMIN

# ========================
# EUREKA (SERVICE DISCOVERY)
# ========================
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka/

# ========================
# JWT CONFIG
# ========================
JWT_SECRET=your_super_secret_key_very_long_and_secure
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
